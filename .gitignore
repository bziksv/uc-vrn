id_rsa
id_ed25519
credentials.json
secrets.json
auth.json
*.secret
*secret*

# Дампы БД (содержат хеши паролей, персональные данные, ключи)
*.sql
*.sql.gz
*.sql.bz2
*.sql.zip
*.dump

